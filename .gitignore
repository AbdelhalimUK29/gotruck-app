frontend/go-truck/yarn-debug.log*
frontend/go-truck/yarn-error.log*
frontend/go-truck/.pnpm-debug.log*

# vercel
frontend/go-truck/.vercel

# typescript
frontend/go-truck/*.tsbuildinfo
frontend/go-truck/next-env.d.ts

